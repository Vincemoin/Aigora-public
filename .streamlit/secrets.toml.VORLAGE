# VORLAGE -- diese Datei wird NICHT deployed und NICHT ins Repo committed
# (siehe .gitignore). Kopiere den Inhalt (mit echten Werten) in:
# Streamlit Cloud -> deine App -> Settings -> Secrets

[access_codes]
"CODE1" = "P-001"
"CODE2" = "P-002"
# ... eine Zeile pro Teilnehmer/in, Codes aus generate_access_links.py

[surfdrive]
username = "HIER_SURFDRIVE_BENUTZERNAME_EINTRAGEN"
password = "HIER_SURFDRIVE_APP-PASSWORT_EINTRAGEN"

[anthropic]
api_key = "HIER_ANTHROPIC_API_KEY_EINTRAGEN"

[openai]
api_key = "HIER_OPENAI_API_KEY_EINTRAGEN"

[model_provider]
name = "anthropic"          # "anthropic" oder "deepseek" -- zum Umschalten nur diesen Wert ändern
# deepseek_model = "deepseek-v4-pro"   # optional, Standard ist bereits deepseek-v4-pro

[deepseek]
api_key = "HIER_DEEPSEEK_API_KEY_EINTRAGEN"   # nur nötig, wenn model_provider.name = "deepseek"

[testing]
sitzung1 = "aktiv"    # "aktiv" / "gesperrt" / "abgeschlossen" / "auto" (Datum entscheidet)
sitzung2 = "aktiv"
sitzung3 = "aktiv"
# WICHTIG: vor dem 17.8. alles auf "auto" setzen oder den Block löschen!
